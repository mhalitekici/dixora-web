# Copy this file to .env for local development.
# Values below are development placeholders. Never reuse them in production.

COMPOSE_PROJECT_NAME=dixora
APP_ENV=development
LOG_LEVEL=INFO
# Keep localhost for normal development. Use 0.0.0.0 only while testing the QR
# menu from a trusted local network, then open http://<computer-lan-ip>:3000.
DIXORA_BIND_HOST=127.0.0.1

# Public URLs used by browsers and generated links.
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
# Internal URL used by the Next.js server inside the Compose network.
BACKEND_API_URL=http://api:8000/api/v1
# Local Compose runs over HTTP. Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
# Leave empty for localhost/single-host deployments. Set a shared parent domain
# such as .dixorapos.com only when authentication must span trusted subdomains.
AUTH_COOKIE_DOMAIN=
# Optional upper bound for a remembered refresh cookie (30 days by default).
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
# UI visibility and backend emergency switch for branch-scoped PIN login.
NEXT_PUBLIC_ENABLE_PIN_LOGIN=true
WEB_PORT=3000
API_PORT=8000

# PostgreSQL
POSTGRES_DB=dixora
POSTGRES_USER=dixora
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dixora:change-me-local-postgres@postgres:5432/dixora

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage (MinIO locally)
MINIO_ROOT_USER=dixora
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dixora
S3_SECRET_KEY=change-me-local-minio
S3_BUCKET=dixora-media
S3_REGION=us-east-1
S3_USE_SSL=false

# FastAPI settings. The `DIXORA_` prefix is required by apps/api.
# Generate production secrets with a cryptographically secure random generator.
DIXORA_ENVIRONMENT=development
DIXORA_API_PREFIX=/api/v1
DIXORA_DATABASE_URL=postgresql+asyncpg://dixora:change-me-local-postgres@postgres:5432/dixora
DIXORA_REDIS_URL=redis://redis:6379/0
DIXORA_LOGIN_RATE_LIMIT_ATTEMPTS=5
DIXORA_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
DIXORA_PIN_LOGIN_ENABLED=true
DIXORA_TRUSTED_DEVICE_DAYS=180
DIXORA_LOYALTY_VERIFICATION_RATE_LIMIT_ATTEMPTS=5
DIXORA_LOYALTY_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=15
DIXORA_LOYALTY_VERIFICATION_IP_RATE_LIMIT_ATTEMPTS=20
DIXORA_LOYALTY_VERIFICATION_TENANT_DAILY_LIMIT=1000
# development: kodu ekranda gösterir; netgsm: gerçek OTP SMS; disabled: 503.
DIXORA_LOYALTY_VERIFICATION_PROVIDER=development
# Netgsm production OTP credentials. Ana hesap yerine yetkisi sınırlandırılmış API alt kullanıcısı kullanın.
DIXORA_NETGSM_USERCODE=
DIXORA_NETGSM_PASSWORD=
DIXORA_NETGSM_MSGHEADER=
DIXORA_NETGSM_TIMEOUT_SECONDS=8
DIXORA_JWT_SECRET=change-me-with-at-least-32-random-characters
DIXORA_ACCESS_TOKEN_MINUTES=15
DIXORA_REFRESH_TOKEN_DAYS=30
DIXORA_SESSION_REFRESH_TOKEN_HOURS=24
DIXORA_CORS_ORIGINS=["http://localhost:3000"]
DIXORA_PRINT_BRIDGE_KEY=change-me-local-print-bridge
DIXORA_AUTO_CREATE_SCHEMA=false
DIXORA_DEV_SEED_ENABLED=true
DIXORA_LOG_LEVEL=INFO
DIXORA_SQL_ECHO=false
DIXORA_S3_ENDPOINT=http://minio:9000
DIXORA_S3_ACCESS_KEY=dixora
DIXORA_S3_SECRET_KEY=change-me-local-minio
DIXORA_S3_BUCKET=dixora-media
DIXORA_S3_REGION=us-east-1
DIXORA_MEDIA_PUBLIC_BASE_URL=http://localhost:8000/api/v1/media
DIXORA_MEDIA_MAX_UPLOAD_BYTES=5242880
DIXORA_MEDIA_MIN_DIMENSION=64
DIXORA_MEDIA_MAX_DIMENSION=8192
DIXORA_MEDIA_MAX_PIXELS=36000000

# Mock Print Bridge
PRINT_BRIDGE_PORT=9100
PRINT_BRIDGE_ID=local-mock-bridge
PRINT_BRIDGE_API_URL=http://api:8000
# Scoped development credential created by the idempotent development seed.
PRINT_BRIDGE_TOKEN=pb_dev_dixora_lab_bridge_2026
# Legacy key auth is accepted only when dev seed mode is explicitly enabled.
PRINT_BRIDGE_API_KEY=change-me-local-print-bridge
PRINT_BRIDGE_PRINTER_IDS=MOCK-KITCHEN,MOCK-BAR
PRINT_BRIDGE_POLL_INTERVAL_MS=2000
PRINT_BRIDGE_REQUEST_TIMEOUT_MS=5000
PRINT_BRIDGE_MAX_CLAIM=5
PRINT_BRIDGE_MOCK_DELAY_MS=250
PRINT_BRIDGE_MOCK_FAILURE_RATE=0
PRINT_BRIDGE_ALLOW_INSECURE_MOCK=false
