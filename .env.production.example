# =============================================================================
# Dixora - production environment template
# =============================================================================
# Copy to .env.production on the host and replace every <GENERATE> below.
# NEVER commit the filled-in file.
#
#   openssl rand -hex 32          # secrets
#   openssl rand -base64 24       # passwords
#
# The API refuses to boot in production if it finds development defaults, weak
# database credentials, SQLite, wildcard CORS, the dev seed, or a development
# mail/phone provider. That validation is a safety net, not a substitute for
# reading this file.
#
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production
# =============================================================================

COMPOSE_PROJECT_NAME=dixora

# ---------------------------------------------------------------------------
# Domain and TLS
# ---------------------------------------------------------------------------
# The canonical host. www redirects to it; auth cookies are host-only, so
# serving both would split sessions.
DIXORA_DOMAIN=dixoratech.com
# Certificate expiry warnings go here.
LETSENCRYPT_EMAIL=ops@dixoratech.com

# ---------------------------------------------------------------------------
# Public URLs - one origin for the app, the API, media and the socket
# ---------------------------------------------------------------------------
# Same-origin on purpose: no CORS preflights, no cross-site cookie rules, and
# no second certificate. NEXT_PUBLIC_* values are compiled into the browser
# bundle at image build time, so changing one needs a rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://dixoratech.com/api/v1
NEXT_PUBLIC_WS_URL=wss://dixoratech.com/api/v1/ws
NEXT_PUBLIC_ENABLE_PIN_LOGIN=true
# The origin printed onto every QR menu code, plus the canonical URL in page
# metadata, the sitemap and robots.txt. Compose refuses to render without it,
# because a missing value does not fail loudly - it bakes localhost links into
# the image and the printed codes lead nowhere.
NEXT_PUBLIC_APP_URL=https://dixoratech.com

# Server-to-server inside the Docker network; never a public URL.
BACKEND_API_URL=http://api:8000/api/v1

# Auth cookies. Secure is mandatory over HTTPS. Leave the domain EMPTY: an
# empty value keeps cookies host-only, which is what a single-origin
# deployment wants. Only set it (".dixoratech.com") if auth must span
# subdomains, which also widens where those cookies can leak.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# ---------------------------------------------------------------------------
# Internal network
# ---------------------------------------------------------------------------
# The API trusts X-Forwarded-For only from this network, which is what makes
# the real client address usable for rate limiting and audit. Keep the two in
# step; widening either one lets a caller choose their own address.
DIXORA_NETWORK_SUBNET=172.28.0.0/16
DIXORA_FORWARDED_ALLOW_IPS=172.28.0.0/16

# ---------------------------------------------------------------------------
# PostgreSQL - the source of truth. Back it up before go-live and nightly.
# ---------------------------------------------------------------------------
POSTGRES_DB=dixora
POSTGRES_USER=dixora_prod
POSTGRES_PASSWORD=<GENERATE>
# Must repeat the credentials above. "dixora:dixora" and anything containing
# "change-me" are rejected at boot.
DIXORA_DATABASE_URL=postgresql+asyncpg://dixora_prod:<GENERATE>@postgres:5432/dixora
# (db_pool_size + db_max_overflow) x API_WORKERS must stay under this.
POSTGRES_MAX_CONNECTIONS=200
API_WORKERS=2
DIXORA_DB_POOL_SIZE=10
DIXORA_DB_MAX_OVERFLOW=20
DIXORA_DB_POOL_TIMEOUT=30
DIXORA_DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis - shared rate-limit counters and realtime fan-out across workers
# ---------------------------------------------------------------------------
# Required once API_WORKERS > 1: a WebSocket lives in one process, and the
# login limiter counts per process without it.
DIXORA_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (MinIO on this host)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=<GENERATE>
MINIO_ROOT_PASSWORD=<GENERATE>
# Reachable only inside the Docker network - MinIO publishes no host port.
DIXORA_S3_ENDPOINT=http://minio:9000
DIXORA_S3_ACCESS_KEY=<GENERATE>
DIXORA_S3_SECRET_KEY=<GENERATE>
DIXORA_S3_BUCKET=dixora-media
DIXORA_S3_REGION=eu-central-1
# Images are served back through the API on the public origin, so this must be
# HTTPS and must match the domain above.
DIXORA_MEDIA_PUBLIC_BASE_URL=https://dixoratech.com/api/v1/media
DIXORA_MEDIA_MAX_UPLOAD_BYTES=5242880
DIXORA_MEDIA_MIN_DIMENSION=64
DIXORA_MEDIA_MAX_DIMENSION=8192
DIXORA_MEDIA_MAX_PIXELS=36000000

# ---------------------------------------------------------------------------
# API core
# ---------------------------------------------------------------------------
DIXORA_ENVIRONMENT=production
DIXORA_API_PREFIX=/api/v1
DIXORA_JWT_SECRET=<GENERATE>
DIXORA_ACCESS_TOKEN_MINUTES=15
DIXORA_REFRESH_TOKEN_DAYS=30
DIXORA_SESSION_REFRESH_TOKEN_HOURS=24
# Both origins are listed so a request that arrives at www before the redirect
# is not rejected on top of being redirected.
DIXORA_CORS_ORIGINS=["https://dixoratech.com","https://www.dixoratech.com"]

# Argon2 login is deliberately expensive; these throttle guessing without
# locking out a shift change.
DIXORA_LOGIN_RATE_LIMIT_ATTEMPTS=5
DIXORA_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
DIXORA_PIN_LOGIN_ENABLED=true
DIXORA_TRUSTED_DEVICE_DAYS=180

# Still required even with no bridge deployed: the API validates it at boot.
DIXORA_PRINT_BRIDGE_KEY=<GENERATE>

# ---------------------------------------------------------------------------
# Development switches - must stay false in production
# ---------------------------------------------------------------------------
# The compose file pins these too, so a stray "true" here changes nothing.
# dev_seed creates demo businesses with published passwords; auto_create_schema
# builds tables outside Alembic and drifts from the migration history.
DIXORA_DEV_SEED_ENABLED=false
DIXORA_AUTO_CREATE_SCHEMA=false
# Swagger, ReDoc and openapi.json are off in production. Set true only to
# debug deliberately, and turn it back off.
DIXORA_EXPOSE_API_DOCS=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# "development" only logs and is rejected in production, so a customer would
# wait forever for a code that was never sent. Use resend (or smtp) when the
# domain's DNS is ready; "disabled" is the honest setting until then - the
# flows that need mail fail loudly instead of pretending.
DIXORA_EMAIL_PROVIDER=disabled
DIXORA_EMAIL_FROM=Dixora <no-reply@dixoratech.com>
DIXORA_RESEND_API_KEY=
DIXORA_EMAIL_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Phone verification (loyalty enrolment)
# ---------------------------------------------------------------------------
# "disabled" until a Netgsm account is live. Switching to netgsm requires all
# three credentials or the API refuses to boot.
DIXORA_LOYALTY_VERIFICATION_PROVIDER=disabled
DIXORA_NETGSM_USERCODE=
DIXORA_NETGSM_PASSWORD=
DIXORA_NETGSM_MSGHEADER=
DIXORA_LOYALTY_VERIFICATION_RATE_LIMIT_ATTEMPTS=5
DIXORA_LOYALTY_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=15
DIXORA_LOYALTY_VERIFICATION_IP_RATE_LIMIT_ATTEMPTS=20
DIXORA_LOYALTY_VERIFICATION_TENANT_DAILY_LIMIT=1000

# ---------------------------------------------------------------------------
# Payments - out of scope for this launch
# ---------------------------------------------------------------------------
# Subscriptions are still invoiced by `app.cli billing-run`; only card
# collection is off. Leave this alone until Iyzico is contracted and tested.
DIXORA_PAYMENT_PROVIDER=none

# ---------------------------------------------------------------------------
# Logging and error reporting
# ---------------------------------------------------------------------------
DIXORA_LOG_LEVEL=INFO
# SQL echo prints every statement with its bound parameters - customer data in
# the logs. Never true here.
DIXORA_SQL_ECHO=false
# Optional. Absent DSN disables Sentry; the app starts either way.
DIXORA_SENTRY_DSN=
DIXORA_SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Read by ops/backup.sh. Keep dumps off the repository and, once there is
# somewhere to put them, off this host as well.
BACKUP_DIR=/srv/dixora-backups
RETENTION_DAYS=30
