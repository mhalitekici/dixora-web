# The only internet-facing configuration in the stack.
#
# Nginx rather than Caddy: edge rate limiting is the point of having a proxy in
# front of the login and registration endpoints at all, and Caddy needs a
# third-party plugin and a custom build for it. `limit_req` is built in here,
# and ACME still works without a plugin through the webroot challenge.
#
# ${DIXORA_DOMAIN} is substituted by the nginx image's own envsubst step at
# container start (files in /etc/nginx/templates ending in .template).

# --- abuse limits ----------------------------------------------------------
# Sized to sit well above what a person does and well below what a script does.
# The application's own Redis limiter is the accurate one - five failed logins
# per account, per window - and these only keep a flood from reaching it.
# 10m of shared memory holds roughly 160k addresses.
limit_req_zone $binary_remote_addr zone=dixora_auth:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=dixora_public:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=dixora_general:10m rate=600r/m;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=dixora_conn:10m;

# WebSocket upgrades must pass through; a plain proxy_pass drops them.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DIXORA_DOMAIN} www.${DIXORA_DOMAIN};

    # Certificate issuance and renewal. Must stay on plain HTTP and must never
    # be redirected, or renewals fail silently until the certificate expires.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Local container health, answered without a certificate.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DIXORA_DOMAIN}$request_uri;
    }
}

# www redirects to the apex, which is the canonical origin: auth cookies are
# host-only, so serving both would silently split every session.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DIXORA_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DIXORA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DIXORA_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    return 301 https://${DIXORA_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DIXORA_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DIXORA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DIXORA_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    # Media uploads are capped at 5 MB by the API; this leaves room for the
    # multipart envelope and rejects anything larger before it is buffered.
    client_max_body_size 12m;
    limit_conn dixora_conn 64;

    # The application sets its own security headers (HSTS, CSP, frame and
    # referrer policy) in next.config.ts. They are not repeated here: two
    # sources for one header is how they end up contradicting each other.

    access_log /var/log/nginx/dixora.access.log;

    # --- brute-force surface ---------------------------------------------
    # Everything that turns a guess into an account, a code or a message.
    location ~ ^/api/(v1/(auth|registrations)|auth|register)(/|$) {
        limit_req zone=dixora_auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://web_upstream;
    }

    location ~ ^/api/v1/(loyalty/public|qr/public)(/|$) {
        limit_req zone=dixora_public burst=30 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api_upstream;
    }

    # --- realtime ---------------------------------------------------------
    location = /api/v1/ws {
        # Not snippets/proxy.conf: this needs its own Connection header, and
        # setting that header twice in one location sends it twice.
        include /etc/nginx/snippets/forwarded.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # A live socket is idle between events; the default 60s would close it.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_pass http://api_upstream;
    }

    # --- API --------------------------------------------------------------
    # Same origin as the app, so cookies and CORS stay simple.
    location /api/v1/ {
        limit_req zone=dixora_general burst=200 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api_upstream;
    }

    # The API's own liveness and readiness probes, deliberately not public.
    location ~ ^/(health|ready)$ {
        allow 127.0.0.1;
        allow ${DIXORA_NETWORK_SUBNET};
        deny all;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api_upstream;
    }

    # --- application ------------------------------------------------------
    location / {
        limit_req zone=dixora_general burst=200 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://web_upstream;
    }
}

upstream api_upstream {
    server api:8000;
    keepalive 32;
}

upstream web_upstream {
    server web:3000;
    keepalive 32;
}
