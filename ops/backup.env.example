# Install as /etc/dixora/backup.env, root-owned mode 0600.
# This is a systemd EnvironmentFile, not a shell script. Do not use `export`.
# Use storage on an independent server/account, never this app's MinIO volume.
RESTIC_REPOSITORY=s3:https://YOUR-INDEPENDENT-S3-HOST/YOUR-BUCKET/dixora
RESTIC_PASSWORD_FILE=/etc/dixora/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ON_SERVER
AWS_SECRET_ACCESS_KEY=REPLACE_ON_SERVER
AWS_DEFAULT_REGION=us-east-1
# SFTP alternative: remove AWS_* and set RESTIC_REPOSITORY below instead.
# Configure noninteractive SSH and known_hosts for the dixora service user.
# RESTIC_REPOSITORY=sftp:backup-user@backup-host:/backups/dixora
RETENTION_DAYS=14
