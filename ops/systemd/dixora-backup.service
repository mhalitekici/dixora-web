[Unit]
Description=Dixora PostgreSQL and MinIO verified backup
Requires=docker.service
After=docker.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dixora
WorkingDirectory=/srv/dixora
Environment=COMPOSE_FILE=/srv/dixora/docker-compose.prod.yml
Environment=COMPOSE_ENV_FILES=/srv/dixora/.env.production
Environment=BACKUP_DIR=/srv/dixora-backups
EnvironmentFile=/etc/dixora/backup.env
UMask=0077
ExecStart=/usr/bin/python3 /srv/dixora/ops/backup.py create --quiesce --offsite
TimeoutStartSec=1h
