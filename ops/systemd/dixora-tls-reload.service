[Unit]
Description=Dixora renewed TLS certificate reload and verification
After=network-online.target docker.service
OnFailure=dixora-alert@%n.service

[Service]
Type=oneshot
User=dixora
WorkingDirectory=/srv/dixora
EnvironmentFile=/etc/dixora/monitor.env
ExecStart=/usr/bin/python3 /srv/dixora/ops/reload_tls.py --domain ${DIXORA_DOMAIN}
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
